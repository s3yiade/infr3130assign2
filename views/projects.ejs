<%- include('partials/header') %>

<section class="container py-5">
    <h1 class="mb-4"><i class="fa-solid fa-folder-open me-2 text-primary"></i><%= title %></h1>
    <div class="row g-4">
        <% projects.forEach(function (project) { %>
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm project-card">
                    <% if (project.image) { %>
                        <img src="<%= project.image %>" class="card-img-top" alt="Screenshot of <%= project.title %>">
                    <% } %>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title"><%= project.title %></h5>
                        <p class="card-text"><%= project.description %></p>
                        <div class="mb-3">
                            <% project.tech.forEach(function (t) { %>
                                <span class="badge text-bg-secondary me-1"><%= t %></span>
                            <% }) %>
                        </div>
                        <div class="mt-auto">
                            <% if (project.github) { %>
                                <a href="<%= project.github %>" target="_blank" rel="noopener" class="btn btn-outline-dark btn-sm">
                                    <i class="fa-brands fa-github me-1"></i>Code
                                </a>
                            <% } %>
                            <% if (project.live) { %>
                                <a href="<%= project.live %>" target="_blank" rel="noopener" class="btn btn-primary btn-sm">
                                    <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Live
                                </a>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
</section>

<%- include('partials/footer') %>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %> | TJ's Portfolio</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/"><i class="fa-solid fa-code me-2"></i>TJ Adetunji</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
        aria-expanded="false" aria-label="Toggle Navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link <%= page === 'index' ? 'active' : '' %>" href="/"><i class="fa-solid fa-house me-1"></i>Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= page === 'about' ? 'active' : '' %>" href="/about"><i class="fa-solid fa-user me-1"></i>About Me</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= page === 'projects' ? 'active' : '' %>" href="/projects"><i class="fa-solid fa-folder me-1"></i>Projects</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link <%= page === 'contact' ? 'active' : '' %>" href="/contact"><i class="fa-solid fa-envelope me-1"></i>Contact Me</a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="flex-grow-1">

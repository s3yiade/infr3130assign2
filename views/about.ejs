<%- include('partials/header') %>

<section class="container py-5">
    <h1 class="mb-4"><i class="fa-solid fa-user me-2 text-primary"></i><%= title %></h1>
    <div class="row g-5 align-items-center">
        <div class="col-md-4 text-center">
            <img src="/images/profile.jpg" alt="Photo of TJ Adetunji" class="img-fluid rounded shadow">
        </div>
        <div class="col-md-8">
            <p class="lead">My name is TJ, and I've been building applications with an emphasis on security for 5 years, going on 6.
            I turn 21 this December, and I run my own company, through which I offer commercial products, a cybersecurity
            start-up, and client-specific development projects.</p>
            <p>My interests lie primarily in cybersecurity, but I've managed to find an intersection between it and development:
            security engineering. When I'm not working on client projects, school work or personal projects, you can find me in the gym,
            where I work out 4 times a week so that my body reflects the state of my mind. It also helps with stress relief.</p>
            <a href="/files/resume.pdf" class="btn btn-primary" target="_blank">
                <i class="fa-solid fa-file-arrow-down me-2"></i>View My Resume
            </a>
        </div>
    </div>

    <h2 class="mt-5 mb-3">Skills</h2>
    <div class="d-flex flex-wrap gap-2">
        <span class="badge text-bg-dark p-2"><i class="fa-brands fa-js me-1"></i>JavaScript</span>
        <span class="badge text-bg-dark p-2"><i class="fa-brands fa-node-js me-1"></i>Node.js</span>
        <span class="badge text-bg-dark p-2"><i class="fa-brands fa-python me-1"></i>Python</span>
        <span class="badge text-bg-dark p-2"><i class="fa-brands fa-html5 me-1"></i>HTML</span>
        <span class="badge text-bg-dark p-2"><i class="fa-brands fa-css3-alt me-1"></i>CSS</span>
        <span class="badge text-bg-dark p-2"><i class="fa-brands fa-git-alt me-1"></i>Git</span>
        <span class="badge text-bg-dark p-2"><i class="fa-brands fa-linux me-1"></i>Linux</span>
    </div>
</section>

<%- include('partials/footer') %>
